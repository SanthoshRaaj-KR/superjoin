# Copy to .env and fill in. .env is gitignored and must never be committed.

OPENAI_API_KEY=sk-...

# Bulk claim extraction: runs once per page, so favour cost.
FKL_MODEL_EXTRACT=gpt-4.1-mini

# Document profiling and the residual-contradiction adjudicator: runs rarely,
# so favour capability.
FKL_MODEL_REASON=gpt-4.1

# Alias/metric canonicalisation (Phase 2).
FKL_MODEL_EMBED=text-embedding-3-small

# Where the append-only store lives.
FKL_DB_URL=sqlite:///data/fkl.sqlite
